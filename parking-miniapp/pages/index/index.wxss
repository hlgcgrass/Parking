@import "../nearby/nearby.wxss";
@import "../mine/mine.wxss";

.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: 212rpx;
  background: #FFFFFF;
  padding: 24rpx 32rpx 28rpx;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 62, 55, 0.04);
}

.home-panel { padding-top: 212rpx; }

.header__top { gap: 16rpx; }
.home-locbar {
  flex: 0 0 144rpx;
  height: 80rpx;
  min-width: 0;
  margin-top: 0;
  padding: 16rpx;
}
.home-locbar .locbar__pin {
  position: relative;
  flex: 0 0 22rpx;
  width: 22rpx;
  height: 22rpx;
  margin-right: 10rpx;
  border-radius: 50% 50% 50% 0;
  background: var(--primary-400);
  transform: rotate(-45deg);
}
.home-locbar .locbar__pin::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  left: 7rpx;
  top: 7rpx;
  border-radius: 50%;
  background: var(--primary-50);
}
.home-locbar .fs-body { font-size: 26rpx; }
.header__searchbar { flex: 1; min-width: 0; }
.header__searchbar .searchbar__ph {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.locbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--primary-50);
  border-radius: var(--radius-lg);
  padding: 16rpx 24rpx;
}
.locbar__pin {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--primary-400);
  margin-right: 12rpx;
  flex-shrink: 0;
}
.locbar__sep { margin: 0 16rpx; color: var(--text-4); }

.searchbar__icon {
  width: 26rpx;
  height: 26rpx;
  border: 2rpx solid var(--text-3);
  border-radius: 50%;
  flex-shrink: 0;
}

.chips-scroll { white-space: nowrap; width: 100%; }
.chips-scroll .chips { display: inline-flex; }

.empty__icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border-radius: var(--radius-xl);
  background: var(--primary-50);
}

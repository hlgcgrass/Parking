.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg-fill);
}
.avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-3);
}

.stats-card {
  display: flex;
  flex-direction: row;
  padding: 32rpx 16rpx;
}
.stat {
  flex: 1;
  text-align: center;
  position: relative;
}
.stat:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 1rpx;
  background: var(--line);
}

.about-text { line-height: 1.7; }

/* ============ 登录授权卡 ============ */
.login-card { padding-top: 32rpx; padding-bottom: 32rpx; }
.login-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-50);
  color: var(--primary-600);
  font-size: 24rpx;
}
.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
  overflow: hidden;
}
.profile-avatar .avatar,
.profile-avatar .avatar--ph {
  width: 96rpx;
  height: 96rpx;
}
.avatar--ph { background: var(--primary-50); }
.avatar--char { font-size: 36rpx; color: var(--primary-600); }

/* 未登录卡：可点头像/按钮拉起微信原生头像选择 */
.avatar-pick-ph {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  font-size: 32rpx;
}
.profile-avatar::after { border: none; }

/* 昵称输入（type=nickname，键盘可一键填微信昵称） */
.nick-input {
  width: 100%;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--text-1);
  background: var(--bg-fill);
  border-radius: 28rpx;
}
.nick-ph { color: var(--text-4); font-size: 24rpx; }
.nick-edit {
  width: 44rpx;
  height: 44rpx;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.nick-edit:active {
  opacity: 0.7;
}
.nick-edit__pencil {
  position: relative;
  width: 24rpx;
  height: 11rpx;
  border: 2rpx solid var(--primary-400);
  border-radius: 6rpx 3rpx 3rpx 6rpx;
  background: transparent;
  transform: rotate(-45deg);
  box-sizing: border-box;
}
.nick-edit__pencil::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: -2rpx;
  width: 2rpx;
  height: 12rpx;
  background: var(--primary-400);
  opacity: 0.65;
}
.nick-edit__pencil::after {
  content: '';
  position: absolute;
  right: -7rpx;
  top: -2rpx;
  width: 0;
  height: 0;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  border-left: 7rpx solid var(--primary-400);
}
.nick-edit__pencil-tip {
  position: absolute;
  z-index: 1;
  right: -5rpx;
  top: 0;
  width: 0;
  height: 0;
  border-top: 4rpx solid transparent;
  border-bottom: 4rpx solid transparent;
  border-left: 5rpx solid var(--bg-card);
}

.btn-block { width: 100%; }
.login-note { line-height: 1.6; }

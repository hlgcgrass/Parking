.empty-ico {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--primary-50);
  color: var(--primary-400);
  font-size: 56rpx;
  line-height: 112rpx;
  text-align: center;
}
.favorites-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 16rpx;
  color: var(--text-4);
  font-size: 22rpx;
}
.favorites-loading__spinner {
  width: 22rpx;
  height: 22rpx;
  margin-right: 10rpx;
  border: 2rpx solid var(--primary-100);
  border-top-color: var(--primary-400);
  border-radius: 50%;
  animation: favorites-loading-spin 0.9s linear infinite;
}
@keyframes favorites-loading-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.empty__btn {
  width: 320rpx;
  margin: 40rpx auto 0;
}

.hero {
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.place-photo {
  margin: 24rpx 32rpx 0;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(16, 62, 55, 0.06);
}
.place-photo__image {
  display: block;
  width: 100%;
  height: 320rpx;
}
.place-photo__caption {
  padding: 14rpx 20rpx 16rpx;
  color: var(--text-4);
  font-size: 20rpx;
  line-height: 1.4;
}

.tipbar__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary-400);
  margin-right: 16rpx;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.park-tip {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  line-height: 1.6;
}

.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.fee-row:last-child { border-bottom: none; }

.calc {
  background: var(--bg-page);
  border-radius: var(--radius-lg);
  padding: 24rpx;
}

.arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--primary-600);
  border-bottom: 2rpx solid var(--primary-600);
  transform: rotate(45deg);
  margin-left: 8rpx;
  transition: transform 0.2s;
}
.arrow--up { transform: rotate(-135deg); }

/* 卡片底部操作区 */
.card__bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}
.fee-toggle {
  flex: 1;
  min-width: 0;
}

/* 收藏 / 点赞 */
.acts {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}
.act {
  height: 64rpx;
  min-width: 108rpx;
  padding: 0 18rpx;
  border-radius: 40rpx;
  background: #FAFCFB;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid transparent;
  transition: all 0.15s ease;
}
.act:active { transform: scale(0.96); }
.act__ico {
  font-size: 28rpx;
  color: var(--text-3);
  margin-right: 8rpx;
  line-height: 1;
}
.act__txt {
  font-size: 24rpx;
  color: var(--text-2);
}
.act:not(.act--on):not(.act--like) {
  border-color: var(--line);
}
.act--on {
  background: var(--primary-50);
  border-color: var(--primary-100);
}
.act--on .act__ico,
.act--on .act__txt { color: var(--primary-600); }
.act--like {
  background: #FDECEC;
  border-color: #F6C9C8;
}
.act--like .act__ico,
.act--like .act__txt { color: var(--danger); }

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  display: flex;
  flex-direction: row;
}
.footer__btn { flex: 1; }

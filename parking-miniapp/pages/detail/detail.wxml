<view class="page" wx:if="{{place || (imagePreview && imagePreview.src && !errorText)}}">

  <!-- 地点信息 -->
  <view class="hero" wx:if="{{place}}">
    <view class="row">
      <text class="fs-display t1 grow">{{place.name}}</text>
    </view>
    <view class="row mt-sm">
      <view class="badge badge--primary">{{place.category}}</view>
      <text class="fs-caption t3" style="margin-left:16rpx">{{place.district}}</text>
      <text class="fs-caption t3" style="margin-left:16rpx">{{place.parkings.length}} 个车场</text>
    </view>
    <view class="fs-caption t3 mt-md">{{place.address}}</view>
  </view>

  <!-- 地点形象图 -->
  <view class="place-photo" wx:if="{{imagePreview && imagePreview.src}}">
    <image
      class="place-photo__image"
      src="{{imagePreview.src}}"
      mode="aspectFill"
      lazy-load="false"
      bindload="onPlaceImageLoad"
      binderror="onPlaceImageError"
    />
    <view class="place-photo__caption">{{imagePreview.alt}} · {{imagePreview.credit}}</view>
  </view>

  <block wx:if="{{place}}">
    <!-- 区域攻略 -->
    <view class="pad" wx:if="{{place.area_tips || place.summary}}">
    <view class="tipbar mt-md">
      <view class="tipbar__dot"></view>
      <view class="grow">
        <view class="fs-caption tp">停车攻略</view>
        <view class="tipbar__text mt-sm">{{place.area_tips || place.summary}}</view>
      </view>
    </view>
    </view>

  <!-- 停车场列表 -->
    <view class="section">
    <view class="between">
      <text class="section__title">停车场</text>
      <text class="section__more">按点赞量排序</text>
    </view>
    </view>

    <view class="card-list mt-md">
    <view class="card" wx:for="{{place.parkings}}" wx:for-index="parkingIndex" wx:key="id">

      <view bindtap="toggleFee" data-index="{{parkingIndex}}">
        <view class="between">
          <view class="grow">
            <view class="row">
              <text class="item__title ellipsis">{{item.name}}</text>
              <view class="parking-location" catchtap="openParkingMap" data-index="{{parkingIndex}}">
                <t-icon name="location-parking-place-filled" size="34rpx" />
              </view>
            </view>
            <view class="parking-fee-summary mt-sm">
              <view wx:if="{{item._feeLines.length}}" class="parking-fee-summary__body">
                <view wx:for="{{item._feeLines}}" wx:for-item="feeLine" wx:key="index">{{feeLine}}</view>
              </view>
              <text wx:else class="parking-fee-summary__empty">收费规则待补充</text>
            </view>
          </view>

          <view class="col" style="align-items:flex-end;margin-left:24rpx">
            <view wx:if="{{item._hasPrice}}">
              <text class="price price--md">¥{{item._priceValue}}</text>
              <text wx:if="{{item._priceUnit}}" class="price__unit">/{{item._priceUnit}}</text>
            </view>
            <text wx:else class="fs-tag t4">价格待补充</text>
          </view>
        </view>

        <view class="row mt-md">
          <view wx:if="{{item.free_minutes}}" class="badge badge--free">免费 {{item.free_minutes}} 分钟</view>
          <view wx:if="{{item.daily_cap}}" class="badge badge--plain" style="margin-left:12rpx">封顶 ¥{{item.daily_cap}}</view>
          <text wx:if="{{item.walk_minutes}}" class="fs-caption t3" style="margin-left:16rpx">步行 {{item.walk_minutes}} 分钟</text>
        </view>

        <view wx:if="{{item._guideLines.length}}" class="fs-caption t2 mt-md park-tip">
          <view wx:for="{{item._guideLines}}" wx:for-item="line" wx:key="index">{{line}}</view>
        </view>
        <view wx:else class="fs-caption t4 mt-md park-tip park-tip--empty">暂无内容</view>

        <view class="card__bottom mt-md">
          <view class="fee-toggle row">
            <text class="fs-caption tp">{{item._open ? '收起完整收费规则' : '查看完整收费规则'}}</text>
            <view class="arrow {{item._open ? 'arrow--up' : ''}}"></view>
          </view>

          <!-- 收藏 / 点赞 -->
          <view class="parking-actions">
            <view class="parking-action {{item.is_favorited ? 'parking-action--selected' : ''}}" catchtap="onFavorite" data-index="{{parkingIndex}}">
              <view class="parking-action__icon"><t-icon name="star-1" size="32rpx" /></view>
              <text class="parking-action__text">{{item.is_favorited ? '已收藏' : '收藏'}}</text>
            </view>
            <view class="parking-action {{item.is_liked ? 'parking-action--liked' : ''}}" catchtap="onLike" data-index="{{parkingIndex}}">
              <view class="parking-action__icon"><t-icon name="heart" size="32rpx" /></view>
              <text class="parking-action__text">{{item.like_count || 0}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 展开：完整收费规则 + 试算 -->
      <view wx:if="{{item._open}}">
        <view class="divider mt-md"></view>

        <view class="mt-md" wx:if="{{item.fee_rules.length}}">
          <view class="fs-caption t3">完整收费规则</view>
          <view class="fee-row" wx:for="{{item.fee_rules}}" wx:for-item="r" wx:key="index">
            <text class="fs-caption t2 grow">{{r._display || r.description}}</text>
          </view>
        </view>
        <view wx:else class="fs-caption t4 mt-md">暂无结构化收费规则，欢迎拍照补充</view>

        <!-- 费用试算 -->
        <view class="calc mt-md" wx:if="{{item.fee_rules && item.fee_rules.length && item._canCalculate}}">
          <view class="fs-caption t3">停车费试算</view>
          <scroll-view scroll-x class="mt-sm" enable-flex>
            <view class="chips">
              <view
                wx:for="{{hoursOptions}}"
                wx:for-item="h"
                wx:key="*this"
                class="chip {{item._hours === h ? 'chip--active' : ''}}"
                data-index="{{parkingIndex}}"
                data-hours="{{h}}"
                catchtap="setHours">
                <text>{{h}} 小时</text>
              </view>
            </view>
          </scroll-view>

          <view class="row mt-md" wx:if="{{item._fee}}">
            <text class="fs-body t2">预计</text>
            <text class="price price--lg" style="margin-left:16rpx">¥{{item._fee.total}}</text>
          </view>
        </view>

        <!-- 来源标注 -->
        <view class="fs-tag t4 mt-md">{{item.confidence_text}} · {{item.source || '未标注来源'}}</view>
      </view>
    </view>
    </view>

    <view class="source-note">数据更新于 2026-09 · 实际收费以现场为准 · 发现错误欢迎纠错</view>
    <view class="safe-bottom" style="height:200rpx"></view>
  </block>
</view>

<view class="page detail-error" wx:elif="{{errorText}}">
  <view class="empty">
    <view class="empty__icon"></view>
    <view class="empty__title">详情暂时打不开</view>
    <view class="empty__desc">{{errorText}}</view>
    <view class="btn-primary" bindtap="retryLoad" style="margin-top:32rpx">重新加载</view>
  </view>
</view>

<!-- 底部操作栏 -->
<view class="footer" wx:if="{{place}}">
  <view class="btn-secondary footer__btn footer__nav-btn" bindtap="openMap">
    <t-icon name="location-filled" size="36rpx" color="#0F6E56" />
    <text>导航</text>
  </view>
  <view class="btn-primary footer__btn" style="margin-left:24rpx" bindtap="onReport">纠错 / 补充</view>
</view>

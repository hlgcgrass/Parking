.search-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}
.searchbar {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--bg-page);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.searchbar__icon {
  width: 26rpx;
  height: 26rpx;
  border: 2rpx solid var(--text-3);
  border-radius: 50%;
  flex-shrink: 0;
}
.search-input { flex: 1; font-size: 28rpx; margin-left: 12rpx; color: var(--text-1); }
.ph { color: var(--text-3); font-size: 28rpx; }
.clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--text-4);
  color: #FFFFFF;
  text-align: center;
  line-height: 34rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
.cancel { flex-shrink: 0; padding-left: 24rpx; }

.chips-wrap {
  padding: 0 32rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.empty__icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border-radius: var(--radius-xl);
  background: var(--primary-50);
}

/* 停车攻略 · 全局样式
   设计令牌依据 docs/UI设计规范.md（风格 A 晨雾青）
   新增样式前先查这里，禁止出现规范外的颜色与圆角 */

page {
  /* 主色 */
  --primary-50: #E1F5EE;
  --primary-100: #9FE1CB;
  --primary-400: #1D9E75;
  --primary-600: #0F6E56;
  --primary-800: #085041;
  /* 中性 */
  --text-1: #2C2C2A;
  --text-2: #5F5E5A;
  --text-3: #888780;
  --text-4: #B4B2A9;
  --bg-page: #F5F7F6;
  --bg-card: #FFFFFF;
  --bg-fill: #F1EFE8;
  --line: #EDEDED;
  /* 语义 */
  --success: #1D9E75;
  --warning: #EF9F27;
  --danger: #E24B4A;
  --saving: #BA7517;
  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  background: var(--bg-page);
  color: var(--text-1);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
               "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, input, button, scroll-view { box-sizing: border-box; }
view { font-size: 28rpx; }
button::after { border: none; }

/* ============ 字号 ============ */
.fs-display { font-size: 40rpx; font-weight: 500; line-height: 1.4; }
.fs-title   { font-size: 34rpx; font-weight: 500; line-height: 1.4; }
.fs-subtitle{ font-size: 30rpx; font-weight: 500; line-height: 1.5; }
.fs-body    { font-size: 28rpx; font-weight: 400; line-height: 1.6; }
.fs-caption { font-size: 24rpx; font-weight: 400; line-height: 1.5; }
.fs-tag     { font-size: 22rpx; font-weight: 400; line-height: 1.4; }

/* ============ 文字色 ============ */
.t1 { color: var(--text-1); }
.t2 { color: var(--text-2); }
.t3 { color: var(--text-3); }
.t4 { color: var(--text-4); }
.tp { color: var(--primary-600); }
.ts { color: var(--saving); }

/* ============ 布局 ============ */
.page { padding: 0 0 48rpx; }
.pad  { padding-left: 32rpx; padding-right: 32rpx; }
.row  { display: flex; flex-direction: row; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.col  { display: flex; flex-direction: column; }
.grow { flex: 1; min-width: 0; }
.mt-sm { margin-top: 16rpx; }
.mt-md { margin-top: 24rpx; }
.mt-lg { margin-top: 32rpx; }
.mb-md { margin-bottom: 24rpx; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ellipsis-2 {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden; text-overflow: ellipsis;
}

/* ============ 卡片 ============ */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 2rpx 8rpx rgba(16, 62, 55, 0.04);
  padding: 32rpx;
}
.card--tap { transition: background 0.15s; }
.card--tap:active { background: #FAFBFA; }
.card-list { padding: 0 32rpx; }
.card-list .card { margin-bottom: 24rpx; }

/* ============ 区块标题 ============ */
.section { padding: 32rpx 32rpx 0; }
.section__title { font-size: 30rpx; font-weight: 500; color: var(--text-1); }
.section__more { font-size: 24rpx; color: var(--text-3); }

/* ============ 搜索框 ============ */
.searchbar {
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--bg-page);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.searchbar__ph { font-size: 28rpx; color: var(--text-3); margin-left: 12rpx; }

/* ============ 标签 chip ============ */
.chips { display: flex; flex-direction: row; gap: 16rpx; }
.chip {
  height: 56rpx;
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  background: var(--bg-fill);
  color: var(--text-2);
  font-size: 24rpx;
  flex-shrink: 0;
}
.chip--active { background: var(--primary-50); color: var(--primary-600); }

/* ============ 按钮 ============ */
.btn-primary {
  height: 88rpx;
  border-radius: var(--radius-lg);
  background: var(--primary-400);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
.btn-primary:active { background: var(--primary-600); }
.btn-primary--disabled { background: var(--primary-50); color: var(--primary-100); }

.btn-secondary {
  height: 88rpx;
  border-radius: var(--radius-lg);
  background: #FFFFFF;
  border: 1rpx solid var(--primary-400);
  color: var(--primary-600);
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-secondary:active { background: var(--primary-50); }

.btn-sm {
  height: 64rpx;
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-50);
  color: var(--primary-600);
  font-size: 24rpx;
}
.btn-sm:active { background: var(--primary-100); }

/* ============ 价格 ============ */
.price { color: var(--primary-600); font-weight: 500; }
.price--lg { font-size: 40rpx; }
.price--md { font-size: 30rpx; }
.price__unit { font-size: 24rpx; font-weight: 400; color: var(--text-3); margin-left: 4rpx; }
.price__tilde { font-size: 24rpx; color: var(--text-3); margin-right: 2rpx; }

/* ============ 状态点 ============ */
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 8rpx; flex-shrink: 0; }
.dot--success { background: var(--success); }
.dot--warning { background: var(--warning); }
.dot--danger  { background: var(--danger); }
.dot--unknown { background: var(--text-4); }

/* ============ 角标 ============ */
.badge {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  line-height: 1;
}
.badge--primary { background: var(--primary-50); color: var(--primary-600); }
.badge--warn    { background: #FAEEDA; color: #854F0B; }
.badge--free    { background: #FAECE7; color: #993C1D; }
.badge--plain   { background: var(--bg-fill); color: var(--text-2); }

/* ============ 提示条 ============ */
.tipbar {
  background: var(--primary-50);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
}
.tipbar__text { font-size: 26rpx; color: var(--primary-800); line-height: 1.6; flex: 1; }

/* ============ 分割线 ============ */
.divider { height: 1rpx; background: var(--line); margin-left: 32rpx; }
.divider--full { margin-left: 0; }

/* ============ 列表项 ============ */
.item { padding: 28rpx 32rpx; background: var(--bg-card); }
.item__main { flex: 1; min-width: 0; }
.item__title { font-size: 30rpx; font-weight: 500; color: var(--text-1); }
.item__sub { font-size: 24rpx; color: var(--text-3); margin-top: 6rpx; }

/* ============ 空状态 ============ */
.empty { padding: 96rpx 48rpx; text-align: center; }
.empty__title { font-size: 30rpx; color: var(--text-2); margin-top: 32rpx; }
.empty__desc { font-size: 24rpx; color: var(--text-3); margin-top: 12rpx; }

/* ============ 骨架屏 ============ */
.skeleton {
  background: linear-gradient();
  background-color: #EDEDED;
  border-radius: var(--radius-md);
}

/* ============ 数据来源标注（诚实设计） ============ */
.source-note {
  font-size: 22rpx;
  color: var(--text-4);
  text-align: center;
  padding: 32rpx 0 16rpx;
  line-height: 1.6;
}

/* ============ 底部安全区（预留自定义悬浮 tabBar 高度） ============ */
.safe-bottom { height: calc(140rpx + env(safe-area-inset-bottom)); }
